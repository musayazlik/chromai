# OpenRouter — https://openrouter.ai/keys
# AI palette generation does not work without this key; if it is missing,
# the app automatically falls back to the local palette library.
OPENROUTER_API_KEY=

# Optional: your site URL for OpenRouter rankings
OPENROUTER_SITE_URL=http://localhost:3000

# Optional: client-side storage of the user's own OpenRouter key.
# NOTE: NEXT_PUBLIC_ values are inlined into the browser bundle and are NOT
# secret — the XOR step is light obfuscation only. Keep these stable; changing
# them invalidates keys already saved in users' browsers.
NEXT_PUBLIC_API_KEY_STORAGE=
NEXT_PUBLIC_API_KEY_SECRET=

# Blog database — SQLite via Prisma. The file lives in `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# n8n → site webhook secret. Must match the value in the n8n workflow.
# Generate a strong value with: openssl rand -hex 32
BLOG_WEBHOOK_SECRET=

# Public base URL used for blog post links in sitemap / metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
